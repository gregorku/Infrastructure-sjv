###############################################################################
#
# Infrastructure-sjv
#
# Template for /docker-data/stacks/infrastructure-sjv/.env.
# This tracked example contains no real public domains, passwords or keys.
#
# Replace example.com hostnames in the runtime .env before deployment.
# Replace set_* values where required.
#
# Rules (enforced by scripts/check-env.sh):
#   - Values starting with set_ are placeholders and are rejected, except for
#     explicitly deferred values such as TRAEFIK_ACME_EMAIL in local TLS mode.
#   - Write values without quotes. $ ` " ' \ and # are not allowed.
#   - Generated secrets are created by scripts/update-env.sh only in the
#     runtime .env and are never printed.
#   - Variable ownership is defined in scripts/lib/env/policy.sh.
#
###############################################################################

TZ=Europe/Prague
COMPOSE_PROJECT_NAME=infrastructure-sjv
DATA_DIR=/docker-data/infrastructure-sjv
BACKUP_LOCAL_DIR=/docker-data/backups/infrastructure-sjv

# Documentation-only hostnames. Replace both in the runtime .env.
SJV_DOMAIN=example.com
MQTT_HOSTNAME=mqtt.example.com

# Docker networks selected for the current VPS layout.
# Existing networks:
#   Incus:          10.10.10.0/24
#   WireGuard:      10.100.101.0/24
#                   10.110.110.0/24
#                   10.120.120.0/24
#   Docker bridge:  172.17.0.0/16
# Keep these four Docker subnets distinct and non-overlapping.
DOCKER_PROXY_SUBNET=172.20.0.0/24
DOCKER_PROXY_GATEWAY=172.20.0.1
DOCKER_INTERNAL_SUBNET=172.21.0.0/24
DOCKER_INTERNAL_GATEWAY=172.21.0.1
DOCKER_MQTT_SUBNET=172.22.0.0/24
DOCKER_MQTT_GATEWAY=172.22.0.1
DOCKER_EGRESS_SUBNET=172.23.0.0/24
DOCKER_EGRESS_GATEWAY=172.23.0.1

# HAProxy sends PROXY protocol v2 to HTTP and HTTPS backends.
# 10.10.10.1 is the expected HAProxy source address; verify it from the
# container before relying on this trusted-peer setting.
PROXY_PROTOCOL_MODE=haproxy
PROXY_PROTOCOL_TRUSTED_IPS=10.10.10.1/32

# Let's Encrypt after real domains and a valid contact email are configured.
TRAEFIK_TLS_MODE=letsencrypt
TRAEFIK_ACME_EMAIL=set_acme_email
# Empty, or PRIVATE_ADDRESS:8443:8443. Never 0.0.0.0.
# Render publishes this port only when dashboard.htpasswd exists outside Git.
TRAEFIK_ADMIN_PUBLISH=10.10.10.20:8443:8443
# Space-separated private CIDRs allowed to reach the Traefik dashboard.
# Home administration currently uses WireGuard 10.100.101.0/24.
ADMIN_IP_ALLOWLIST=10.100.101.0/24

# Pinned images. Tag and digest together; latest is rejected.
# The CrowdSec bouncer API key is not an environment variable.
# Traefik 3.7 is the supported line. v3.7.17 is the newest published release
# (v3.7.18 was not on GitHub or Docker Hub on 2026-11-09). Digests are the
# multi-arch index digests from registry-1.docker.io.
TRAEFIK_IMAGE=docker.io/library/traefik:v3.7.17@sha256:f4bb143d1135a579b630ed491e17ec50f6f7c9c6a30585ff3d385471d2a86f5a
CROWDSEC_IMAGE=docker.io/crowdsecurity/crowdsec:v1.8.2@sha256:65b74942f7e7ed5c60fde4ac15fc4ba715904c398c8b16dd451f4907d90347d4
CROWDSEC_BOUNCER_PLUGIN=v1.8.1
# sha256 of the zip plugins.traefik.io serves for v1.8.1. Not an API key.
CROWDSEC_BOUNCER_PLUGIN_HASH=1c63fab00b5c777fc02dc657ce24557c1e7f8548af4fd13fc4bfd8f0aa91f12d
# PostgreSQL 19.0 base for the local sjv-postgresql image (decision R33).
# Tag 19.0, not the moving tag 19 and not latest. The digest is the
# multi-arch index digest from registry-1.docker.io on 2026-11-20.
# pgBackRest 2.60.1 is installed into that image. Restic stays 0.19.1.
POSTGRES_IMAGE=docker.io/library/postgres:19.0@sha256:bb6e70add742cd868fb62cb3b2f67d1dd2bdd2b65a521e778420748753687c60
PGBACKREST_VERSION=2.60.1

PG_DB=sjv
PG_BOOTSTRAP_USER=sjv_bootstrap
PG_BOOTSTRAP_PASSWORD=set_pg_bootstrap_password
PG_OWNER_USER=sjv_owner
PG_OWNER_PASSWORD=set_pg_owner_password
PG_API_USER=sjv_api
PG_API_PASSWORD=set_pg_api_password
PG_COLLECTOR_USER=sjv_collector
PG_COLLECTOR_PASSWORD=set_pg_collector_password
PG_WORKER_USER=sjv_worker
PG_WORKER_PASSWORD=set_pg_worker_password
PG_MAINTENANCE_USER=sjv_maintenance
PG_MAINTENANCE_PASSWORD=set_pg_maintenance_password
PG_READONLY_USER=sjv_readonly
PG_READONLY_PASSWORD=set_pg_readonly_password

MQTT_ADMIN_USER=sjv-admin
MQTT_ADMIN_PASSWORD=set_mqtt_admin_password
MQTT_COLLECTOR_USER=sjv-collector
MQTT_COLLECTOR_PASSWORD=set_mqtt_collector_password
MQTT_HEALTHCHECK_USER=sjv-healthcheck
MQTT_HEALTHCHECK_PASSWORD=set_mqtt_healthcheck_password

# Messages older than this are answered with too_old. Must stay shorter than
# INGEST_KEY_RETENTION_DAYS (docs/data-ingestion.md). 30 is the proposal.
INGEST_MAX_MESSAGE_AGE_DAYS=30
INGEST_KEY_RETENTION_DAYS=60

# Remote backup (docs/backup-strategy.md). Leave both empty until the
# runtime .env is prepared. The repository URL keeps the username and
# must not contain the password:
# rest:https://infrastructure-sjv@10.100.101.12:8000/infrastructure-sjv/
# RESTIC_REST_PASSWORD is the rest-server password. The repository key
# password is a mode 600 file, not a variable.
RESTIC_REPOSITORY=
RESTIC_REST_PASSWORD=

# Empty SMTP_HOST keeps notifications queued. SMTP_SECURITY: starttls or tls.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

LOG_MAX_SIZE=20m
LOG_MAX_FILES=5

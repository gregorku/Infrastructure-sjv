###############################################################################
#
# Infrastructure-sjv
#
# Template for /docker-data/stacks/infrastructure-sjv/.env.
# This file contains no real passwords, tokens, keys or addresses.
#
# Rules (enforced by scripts/check-env.sh):
#   - Values starting with set_ are placeholders and are rejected.
#   - Write values without quotes. $ ` " ' \ and # are not allowed.
#   - Generated secrets are created by scripts/update-env.sh only in the
#     runtime .env and are never printed.
#   - Variable ownership is defined in scripts/lib/env/policy.sh.
#
###############################################################################

TZ=Europe/Prague
COMPOSE_PROJECT_NAME=infrastructure-sjv
DATA_DIR=/docker-data/infrastructure-sjv
BACKUP_LOCAL_DIR=/docker-data/backups/infrastructure-sjv
SJV_DOMAIN=sjv.serveftp.org

# sjv-mqtt.serveftp.org if that name can be created, otherwise sjv.serveftp.org.
MQTT_HOSTNAME=set_mqtt_hostname

# Docker networks (docs/architecture.md). Choose private ranges that overlap
# neither each other nor 10.10.10.0/24, 10.100.100.0/24, 10.110.100.0/24,
# 10.120.100.0/24 or 172.17.0.0/16.
DOCKER_PROXY_SUBNET=set_docker_proxy_subnet
DOCKER_PROXY_GATEWAY=set_docker_proxy_gateway
DOCKER_INTERNAL_SUBNET=set_docker_internal_subnet
DOCKER_INTERNAL_GATEWAY=set_docker_internal_gateway
DOCKER_MQTT_SUBNET=set_docker_mqtt_subnet
DOCKER_MQTT_GATEWAY=set_docker_mqtt_gateway
DOCKER_EGRESS_SUBNET=set_docker_egress_subnet
DOCKER_EGRESS_GATEWAY=set_docker_egress_gateway

# local: no PROXY protocol, for tests before the HAProxy route exists.
# haproxy: requires TRAEFIK_TLS_MODE=letsencrypt and the observed HAProxy
# source address as a /32 in PROXY_PROTOCOL_TRUSTED_IPS.
PROXY_PROTOCOL_MODE=local
PROXY_PROTOCOL_TRUSTED_IPS=
TRAEFIK_TLS_MODE=local
TRAEFIK_ACME_EMAIL=set_acme_email
# Empty, or PRIVATE_ADDRESS:8443:8443. Never 0.0.0.0.
TRAEFIK_ADMIN_PUBLISH=
# Space-separated private CIDRs allowed to reach the Traefik dashboard.
ADMIN_IP_ALLOWLIST=set_admin_allowlist

# Pinned images. Tag and digest together; latest is rejected.
# The CrowdSec bouncer API key is not an environment variable.
# Traefik 3.7 is the supported line. v3.7.17 is the newest published release
# (v3.7.18 was not on GitHub or Docker Hub on 2026-11-09). Digests are the
# multi-arch index digests from registry-1.docker.io.
TRAEFIK_IMAGE=docker.io/library/traefik:v3.7.17@sha256:f4bb143d1135a579b630ed491e17ec50f6f7c9c6a30585ff3d385471d2a86f5a
CROWDSEC_IMAGE=docker.io/crowdsecurity/crowdsec:v1.8.2@sha256:65b74942f7e7ed5c60fde4ac15fc4ba715904c398c8b16dd451f4907d90347d4
CROWDSEC_BOUNCER_PLUGIN=v1.8.1
# sha256 of the zip plugins.traefik.io serves for v1.8.1. Not an API key.
CROWDSEC_BOUNCER_PLUGIN_HASH=1c63fab00b5c777fc02dc657ce24557c1e7f8548af4fd13fc4bfd8f0aa91f12d

PG_DB=sjv
PG_BOOTSTRAP_USER=sjv_bootstrap
PG_BOOTSTRAP_PASSWORD=set_pg_bootstrap_password
PG_OWNER_USER=sjv_owner
PG_OWNER_PASSWORD=set_pg_owner_password
PG_API_USER=sjv_api
PG_API_PASSWORD=set_pg_api_password
PG_COLLECTOR_USER=sjv_collector
PG_COLLECTOR_PASSWORD=set_pg_collector_password
PG_WORKER_USER=sjv_worker
PG_WORKER_PASSWORD=set_pg_worker_password
PG_MAINTENANCE_USER=sjv_maintenance
PG_MAINTENANCE_PASSWORD=set_pg_maintenance_password
PG_READONLY_USER=sjv_readonly
PG_READONLY_PASSWORD=set_pg_readonly_password

MQTT_ADMIN_USER=sjv-admin
MQTT_ADMIN_PASSWORD=set_mqtt_admin_password
MQTT_COLLECTOR_USER=sjv-collector
MQTT_COLLECTOR_PASSWORD=set_mqtt_collector_password
MQTT_HEALTHCHECK_USER=sjv-healthcheck
MQTT_HEALTHCHECK_PASSWORD=set_mqtt_healthcheck_password

# Messages older than this are answered with too_old. Must stay shorter than
# INGEST_KEY_RETENTION_DAYS (docs/data-ingestion.md). 30 is the proposal.
INGEST_MAX_MESSAGE_AGE_DAYS=30
INGEST_KEY_RETENTION_DAYS=60

# Remote backup (docs/backup-strategy.md). Empty until the home rest-server
# exists: rest:https://infrastructure-sjv@HOST:PORT/infrastructure-sjv/
RESTIC_REPOSITORY=
RESTIC_REST_PASSWORD=

# Empty SMTP_HOST keeps notifications queued. SMTP_SECURITY: starttls or tls.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
